<?php

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Tweakwise\Magento2Tweakwise\Model\Analytics\Tag\ProductView;
use Tweakwise\Magento2Tweakwise\Model\NavigationConfig;
use Tweakwise\Magento2Tweakwise\ViewModel\PersonalMerchandisingAnalytics;

/** @var $block Template */
/** @var $escaper Escaper */

/** @var PersonalMerchandisingAnalytics $viewModel */
$viewModel = $block->getData('viewModel');

/** @var NavigationConfig $tweakwiseNavigationConfig */
$tweakwiseNavigationConfig = $block->getData('tweakwise_navigation_config');
$jsFormConfig = $tweakwiseNavigationConfig ? json_decode($tweakwiseNavigationConfig->getJsFormConfig()) : [];
$twRequestId = $jsFormConfig->tweakwiseNavigationForm->twRequestId ?? '';

$eventsData = $viewModel->getEventsData($twRequestId);

// Fallback product data for the add-to-cart mixin on product view pages, where there's no
// window.tweakwiseListingProductData entry to read a productKey/price from like on category/search
// listings (see js/mixins/catalog-add-to-cart-mixin.js). Omitted when isAmbiguous().
$productTag = ((array)$block->getData('data_layer'))['product'] ?? null;
$currentProduct = $productTag instanceof ProductView && !$productTag->isAmbiguous()
    ? ['productKey' => $productTag->get(), 'price' => $productTag->getPrice()]
    : null;
?>

<script type="text/x-magento-init">
    {
        "*": {
            "Tweakwise_Magento2Tweakwise/js/analytics": {
                "eventsData": <?= $eventsData ?>,
                "currentProduct": <?= /* @noEscape */ json_encode($currentProduct) ?>,
                "bindItemClickEventsConfig": {
                    "productListSelector": "<?= $escaper->escapeHtmlAttr($jsFormConfig->tweakwiseNavigationForm->productListSelector ?? ''); ?>",
                    "productSelector": "<?= $escaper->escapeHtmlAttr($jsFormConfig->tweakwiseNavigationForm->productSelector ?? ''); ?>",
                    "twRequestId": "<?= $escaper->escapeHtmlAttr($twRequestId); ?>"
                }
            }
        }
    }
</script>
<script src="<?= $escaper->escapeHtmlAttr($block->getViewFileUrl('Tweakwise_Magento2Tweakwise::js/analytics.js')); ?>"></script>
